# Where Spring is listening. Must be an origin the backend's
# CORS_ALLOWED_ORIGINS lets in from the other direction.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Development only, and unset by default.
#
# Lets the fee-payment page sign a mock gateway callback in the browser so the whole
# payment path -- order, signed callback, verification, ledger credit -- can be exercised
# without a real provider. The value must match MockPaymentGateway.DEV_SECRET on the
# backend you are pointing at.
#
# Everything in NEXT_PUBLIC_* is inlined into the JavaScript bundle and readable by
# anyone who loads the page. Setting this in a deployed build would publish the signing
# secret to every visitor, which is why it ships commented out: with it unset, the page
# stops at initiation and says so.
# NEXT_PUBLIC_MOCK_GATEWAY_SECRET=mock-gateway-development-secret
