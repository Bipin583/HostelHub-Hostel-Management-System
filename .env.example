# Copy to .env and fill in JWT_SECRET. Read by docker compose only; the backend
# and frontend each have their own configuration when run directly.
#
#   cp .env.example .env
#   docker compose up --build

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signs access tokens. There is no default anywhere in the stack: an unset secret
# stops the application rather than falling back to a well-known value that would
# let anyone mint an admin token. Generate one:
#
#   openssl rand -base64 48
#
JWT_SECRET=

# ---------------------------------------------------------------------------
# Development accounts
# ---------------------------------------------------------------------------

# Creates admin, lh_warden, mh_warden and six students, all with this password.
# Leave it empty and the seeder creates nothing and says so in the log -- there is
# no hardcoded fallback for anyone to try against a deployed instance. The seeder
# is idempotent and never resets a password that has since been changed.
DEV_SEED_PASSWORD=change-me-locally

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# The origin the BROWSER uses to reach Spring, inlined into the JavaScript bundle
# at build time. It must be the host-published address, not the compose service
# name: the code that uses it runs in a browser, which is not on the compose
# network. If you change the port below, change both of these together.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

FRONTEND_PORT=3000
BACKEND_PORT=8080
DATABASE_PORT=5432

# ---------------------------------------------------------------------------
# Database (defaults are fine for local work)
# ---------------------------------------------------------------------------

DATABASE_NAME=hostelops
DATABASE_USERNAME=hostelops
DATABASE_PASSWORD=hostelops

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# `mock` settles payments locally. `razorpay` needs RAZORPAY_KEY_ID and
# RAZORPAY_KEY_SECRET, which are passed to the backend and never to the browser.
PAYMENT_PROVIDER=mock

# The fee-reminder and absence-scan crons. Set false if a nightly job firing
# mid-demo would be inconvenient; /admin/jobs can run either on demand.
SCHEDULING_ENABLED=true

APP_LOG_LEVEL=INFO
